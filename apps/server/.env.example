# MySQL
MYSQL_URL=mysql://LavaAnime:password@localhost:3306/lavaanime

# Bangumi（影响服务端获取 bangumi cache 的地址。用于国内加速 / 过墙）
BANGUMI_API_HOST=https://api.bgm.tv
# Bangumi 的图片地址替换（仅影响接口返回值，用于国内加速 / 过墙）
BANGUMI_IMAGE_HOST=https://lain.bgm.tv
# 是否在封面图地址后追加 /poster 后缀（仅影响接口返回值）
BANGUMI_IMAGE_APPEND_POSTER=false

# Log
LOG_LEVEL=info
LOG_DIR=logs
LOG_FILE=app.log

# Security
SECURITY_TRUST_PROXY=true
SECURITY_LOGIN_MAX_TRY=10
SECURITY_BAN_WAIT_MINUTES=10
SECURITY_TOKEN_EXPIRATION_DAYS=30
