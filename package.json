{
  "private": true,
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "build": "pnpm --filter @lavaanime/shared build && pnpm -r --parallel --filter @lavaanime/web --filter @lavaanime/server build",
    "typecheck": "pnpm -r typecheck",
    "start": "pnpm --filter @lavaanime/server start",
    "test": "pnpm --filter @lavaanime/server test",
    "test:full": "bash scripts/test-full.sh",
    "sync": "pnpm --filter @lavaanime/server sync",
    "db:generate": "pnpm --filter @lavaanime/server db:generate",
    "db:push": "pnpm --filter @lavaanime/server db:push",
    "db:migrate": "pnpm --filter @lavaanime/server db:migrate"
  },
  "packageManager": "pnpm@11.8.0+sha512.c1f5e7c4cb241c8f174b743851d82f42b802324afc8b0f116b96adb15aa06664948dde36960a3ba1079ba5b4b29dd0140135b94b5b5f5263592249d68e555f26"
}
